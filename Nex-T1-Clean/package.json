  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=8192 node ./scripts/next-build-phased.mjs",
    "worker": "tsx src/workers/workflow.ts",
    "worker:queue": "tsx src/workers/queue.ts",
    "worker:solana-agentkit": "tsx src/workers/solana-autonomous-agent.ts",
    "dev": "bash ./scripts/dev.sh",
    "dev:raw": "next dev",
    "lint": "eslint . && pnpm lint:better-auth",
    "lint:ci": "pnpm lint && pnpm lint:runtime-js && pnpm lint:untyped-json && pnpm lint:dead && pnpm lint:dup",
    "lint:runtime-js": "node ./scripts/quality/check-runtime-js.mjs",
    "lint:untyped-json": "node ./scripts/quality/check-untyped-json.mjs",
    "preflight": "pnpm exec tsx scripts/preflight-env.ts --strict --scope=all",
    "preflight:ci": "pnpm exec tsx scripts/preflight-env.ts --ci --scope=all",
    "typecheck": "node --max-old-space-size=6144 ./node_modules/typescript/bin/tsc --noEmit --pretty false",
    "typecheck:ai-chat": "node --max-old-space-size=6144 ./node_modules/typescript/bin/tsc -p tsconfig.ai-chat.json --noEmit --pretty false",
    "lint:dead": "pnpm exec ts-prune -p tsconfig.json --ignore \"(.test|.spec|\\.d)\\\\.tsx?$|^src/app/|^src/modules/ai/chatbot/toolset\"",
    "lint:dup": "pnpm exec jscpd --min-tokens 90 --max-lines 400 --ignore \"**/{.next,node_modules,coverage,dist,build,out,.turbo}/**\" src tests scripts docs",
    "lint-docs": "./docs/scripts/verify-chatbot-docs.sh",
    "lint:better-auth": "node ./scripts/check-better-auth.js",
    "icons:manifest": "node ./scripts/generate-icon-manifest.mjs",
    "clean:next": "rimraf .next .next-build .next-dev || rm -rf .next .next-build .next-dev",
    "prepare:standalone": "node ./scripts/prepare-standalone.mjs",
    "perf:ci": "pnpm dlx @lhci/cli@0.15.1 autorun --config=./lighthouserc.json",
    "perf:analyze": "node ./scripts/perf/run-bundle-analyzer.mjs",
    "perf:budgets": "node ./scripts/perf/check-build-budgets.mjs",
    "perf:profile": "node ./scripts/perf/run-profile-build.mjs",
    "bundle:check": "ENFORCE_BUNDLE_BUDGET=1 NEXT_BUNDLE_ANALYZER=1 next build",
    "start": "next start",
    "test": "vitest",
    "test:e2e": "playwright test",
    "bedrock:list-aliases": "tsx scripts/list-bedrock-aliases.ts",
    "sqs:create": "node ./scripts/sqs/create-queue.cjs",
    "redis:bootstrap": "node ./scripts/redis/bootstrap.mjs",
    "db:report": "node ./scripts/db/report.mjs",
    "backfill:solana": "node ./scripts/backfill-solana-wallets.mjs",
    "backfill:solana:dry-run": "node ./scripts/backfill-solana-wallets.mjs --dry-run",
    "backfill:wallets": "node ./scripts/backfill-all-wallets.mjs",
    "backfill:wallets:dry-run": "node ./scripts/backfill-all-wallets.mjs --dry-run",
    "backfill:wallets:evm": "node ./scripts/backfill-all-wallets.mjs --evm-only",
    "monitors:sync": "npx tsx scripts/sync-monitors.ts",
    "prompts:download": "pnpm exec tsx scripts/download-prompts-from-langfuse.ts",
    "mcp:moralis": "bash ./scripts/run-moralis-mcp.sh",
    "rebuild": "pnpm rebuild",
    "launchpad:preflight": "node ./scripts/launchpad/check-onchain-prereqs.mjs",
    "smoke:market": "pnpm exec tsx scripts/smoke-market.ts"
  },
