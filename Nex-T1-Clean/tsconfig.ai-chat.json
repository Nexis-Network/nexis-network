{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false
  },
  "include": [
    "src/app/api/chat/**/*.ts",
    "src/lib/hooks/chat/**/*.ts",
    "src/lib/hooks/chat/**/*.tsx",
    "src/modules/ai/tools/**/*.ts",
    "src/modules/chat/**/*.ts",
