#!/bin/sh

STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$')
if [ -n "$STAGED" ]; then
  echo "[pre-commit] Linting staged files..."
  pnpm exec eslint $STAGED --max-warnings 0
  if [ $? -ne 0 ]; then
    echo "[pre-commit] ESLint failed. Fix errors before committing."
    exit 1
  fi
fi
