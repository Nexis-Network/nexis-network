POLYMARKET_CRED_ENCRYPTION_KEY=

# Thirdweb configuration
# Get your client ID from https://thirdweb.com/dashboard
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=
# Get your secret key from https://thirdweb.com/dashboard
# Required for server-side operations and gasless transactions.
# Can also be set as THIRDWEB_ACCESS_TOKEN
THIRDWEB_SECRET_KEY=

# Redis / rate limiting
UPSTASH_REDIS_REST_URL=__UPSTASH_URL__
UPSTASH_REDIS_REST_TOKEN=__UPSTASH_TOKEN__
# Preferred: private/internal Redis URL used by the app runtime
NEX_REDIS_URL=
# Optional shared alias used by background jobs and diagnostics
SHARED_CACHE_URL=
# Optional: public Redis connection string fallback (Railway/Redis Stack)
# REDIS_URL=redis://<user>:<password>@<host>:<port>
# Optional: throttle Redis fallback warnings emitted by proxy routes (ms)
PROXY_REDIS_ERROR_LOG_COOLDOWN_MS=60000

# Rate limiting
NEX_RATE_LIMIT_MAX=100
NEX_RATE_LIMIT_WINDOW=1h

# Observability (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
NEX_LOG_LEVEL=info

# Paid fetch allowlist
NEX_PAID_FETCH_ALLOWLIST=api.example.com

# Cron / internal jobs (set a strong random value in production)
CRON_SECRET=

# Task scheduling & worker auth (use SEPARATE secrets for dispatch vs run)
# NEX_TASK_DISPATCH_KEY authenticates the cron-triggered dispatch worker (/api/workers/tasks/dispatch)
NEX_TASK_DISPATCH_KEY=
# NEX_TASK_RUN_KEY authenticates the task execution worker (/api/workers/tasks/run)
# IMPORTANT: Must be different from NEX_TASK_DISPATCH_KEY for proper secret separation
NEX_TASK_RUN_KEY=
# TASK_WEBHOOK_SECRET signs AWS Scheduler webhook payloads to /api/webhooks/run-task
TASK_WEBHOOK_SECRET=

# Phala (TEE)
PHALA_BASE_URL=
PHALA_PROJECT_ID=
PHALA_TOKEN=

