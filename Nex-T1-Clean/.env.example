# CoinGecko REST API (used by /proxy/coingecko/*)
# Preferred:
# - PRO: set COINGECKO_PRO_API_KEY to use https://pro-api.coingecko.com/api/v3
# - DEMO: set COINGECKO_DEMO_API_KEY to use x-cg-demo-api-key on the public base
# Backward compatibility:
# - COINGECKO_API_KEY is still supported; if CoinGecko returns error_code=10011
#   we auto-fallback to the demo host/header.
COINGECKO_API_KEY=
COINGECKO_DEMO_API_KEY=
# Optional explicit base override (defaults are auto-selected from keys):
