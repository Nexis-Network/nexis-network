ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# ── Workflow Orchestration Feature Flags ──────────────────────────
# All default to disabled (false). Enable incrementally in staging first.

# Enables deterministic workflow step gates and prerequisite enforcement.
# When true, financial tools are blocked until verification receipts exist,
# and multi-concern requests are decomposed into parallel sub-tasks.
# NEX_WORKFLOW_GATES_ENABLED=false

# Enables normalized error classification with 5 error categories
# (transient, validation, business_rule, permission, internal) and
# automatic retry with exponential backoff for transient failures.
# NEX_ERROR_CONTRACT_ENABLED=false

# Enables the escalate_to_human tool and Supabase persistence for
# structured handoff summaries when the agent cannot safely proceed.
# NEX_HANDOFF_ENABLED=false

# Enables role-based tool access filtering. Each agent role (orchestrator,
# market_analyst, wallet_operator, etc.) only sees tools relevant to
# its category. Also enables command-level restrictions on multi-command tools.
# NEX_ROLE_SCOPING_ENABLED=false
