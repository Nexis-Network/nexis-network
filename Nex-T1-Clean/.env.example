# Duplicate this file to `.env` / `.env.local` and fill in secrets from your
# secret manager. Never commit real values.

# Observability / Sentry
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_TRACES_SAMPLE_RATE="0.2"
SENTRY_PROFILES_SAMPLE_RATE="0.2"
SENTRY_REPLAYS_SESSION_SAMPLE_RATE="0.0"
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE="1.0"

# AWS / Bedrock (Agents + Memory + Code Interpreter)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=
BEDROCK_MEMORY_ID=
# Optional: override default built-in strategy IDs if you created custom strategies in Bedrock
BEDROCK_MEMORY_STRATEGY_SUMMARY_ID=summary_builtin_r3hy3
BEDROCK_MEMORY_STRATEGY_SEMANTIC_ID=semantic_builtin_r3hy3
BEDROCK_MEMORY_STRATEGY_PREFERENCE_ID=preference_builtin_r3hy3
# Short/long term Redis-backed caches used alongside Bedrock Core Memory
BEDROCK_SHORT_TERM_PREFIX=bedrock:short-term:
BEDROCK_SHORT_TERM_TTL_SECONDS=3600
BEDROCK_LONG_TERM_PREFIX=bedrock:long-term:
BEDROCK_LONG_TERM_TTL_SECONDS=2592000

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: only needed for server-side writes/migrations (keep secret)
SANITY_API_TOKEN=

NEX_API_BASE=https://api.nex-t1.ai
NEXT_PUBLIC_NEX_API_BASE=/api/nex
NEXT_PUBLIC_BACKEND_BASE=https://api.nex-t1.ai/api/v1

# Supabase project configuration
# Used for building absolute redirect URLs (OAuth callback + magic link confirm).
# In production, set this to your public app origin, e.g. https://nex-t1.ai
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional alias used by some server-only helpers.
SITE_URL=http://localhost:3000
# Optional: base URL used when server-side origin cannot be inferred.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Must be an origin (no path). Do NOT paste the OAuth callback (…/auth/v1/callback) here.
# If you use a Supabase custom domain, this should be the custom origin, e.g. https://auth.nex-t1.ai
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Optional: if NEXT_PUBLIC_SUPABASE_URL points at an auth-only domain, set the project/Kong origin here
# so PostgREST/storage calls use the correct base URL.
NEXT_PUBLIC_SUPABASE_PROJECT_URL=https://your-project.supabase.co
# Server-side Supabase URL. Keep the same public origin in most deployments; on Railway
# you may set this to the private domain (e.g. http://<kong>.railway.internal) to avoid egress
# while keeping NEXT_PUBLIC_SUPABASE_URL pointing at the public origin.
SUPABASE_URL=https://your-project.supabase.co
# Optional: server-side project/Kong origin override when SUPABASE_URL is not set.
SUPABASE_PROJECT_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key # server-side use only; do not expose publicly
# Optional: override JWKS location (defaults to Supabase .well-known path)
NEXT_PUBLIC_SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Cloudflare (R2 / KV / Vectorize)
# Use either CLOUDFLARE_API_TOKEN or CLOUDFLARE_API_KEY + CLOUDFLARE_EMAIL
NEXT_PUBLIC_ASSETS_URL=https://assets.nex-t1.ai
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_KEY=
CLOUDFLARE_EMAIL=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_VECTORIZE_INDEX=nex-agent-memory

# Wallet-based auth (EVM/Solana)
# Notes:
# - Requires SUPABASE_SERVICE_ROLE_KEY on the server (used to mint sessions).
# - WALLET_EMAIL_SALT is REQUIRED in production. Must be a stable 32+ char secret.
#   Used to HMAC wallet addresses into deterministic emails. Without it, wallet
#   addresses are enumerable from email patterns. Changing it orphans existing wallet users.
#   Generate with: openssl rand -hex 32
WALLET_EMAIL_SALT=CHANGE_ME_generate_with_openssl_rand_hex_32
WALLET_LOGIN_EMAIL_DOMAIN=wallet.nex-t1.ai
WALLET_CHALLENGE_TTL_SECONDS=300

# Account Kit configuration
NEXT_PUBLIC_ACCOUNT_KIT_APP_ID=your-account-kit-app-id
NEXT_PUBLIC_SESSION_EXPIRY_MS=900000
LEADERBOARD_LOCAL_MODE=false

# Development Mode Auth Bypass
# If set to true, protected routes like /app will be accessible without a session on localhost:3000.
# Only works when NODE_ENV is not production.
DEV_AUTH_BYPASS=false
# Optional: mock user ID for development
NEXT_PUBLIC_DEV_AUTH_USER_ID=dev-user-001

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=__OPENAI_KEY__
AI_OPENAI_API_KEY=__OPENAI_KEY__
ANTHROPIC_API_KEY=__ANTHROPIC_KEY__

# ============================================================================
# AI Gateway & Chat Pipeline Configuration
# ============================================================================
# Primary: Vercel AI Gateway (recommended for production)
AI_GATEWAY_API_KEY=__AI_GATEWAY_KEY__
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1/ai
# Legacy alias (deprecated, use AI_GATEWAY_API_KEY instead)
# VERCEL_AI_GATEWAY_API_KEY=

# Fallback: Direct OpenAI (used when AI Gateway is bypassed)
# NEX_OPENAI_API_KEY=__OPENAI_KEY__

# Feature flag: Set to 'true' to bypass AI Gateway and use direct OpenAI
NEX_BYPASS_AI_GATEWAY=false

# Superagent Guardrails (optional)
SUPERAGENT_API_KEY=
SUPERAGENT_BASE_URL=https://api.superagent.sh
SUPERAGENT_MODE=monitor
SUPERAGENT_TOOL_GUARD_ENABLED=true
SUPERAGENT_FILE_SCAN_ENABLED=true
SUPERAGENT_OUTPUT_VERIFY_ENABLED=true
SUPERAGENT_REDACT_ENABLED=true
SUPERAGENT_BLOCKING_THRESHOLD=high
SUPERAGENT_ALLOWED_TOOLS=
SUPERAGENT_TRUSTED_DOMAINS=
SUPERAGENT_GUARDRAILS_DISABLED=false

# Rate Limiting & Credits
NEX_CHAT_RATE_LIMIT_MAX=20
NEX_CHAT_RATE_LIMIT_WINDOW=60
NEX_CHAT_HIGH_COST_CREDITS=5
NEX_CHAT_STANDARD_CREDITS=1

# Tool Artifacts
NEX_TOOL_ARTIFACT_TTL=3600
# Signature secret for launchpad payout receipts (falls back to TASK_WEBHOOK_SECRET if unset)
RECEIPT_SIGNING_SECRET=
# Legacy fallback for inline <antArtifact> parsing (default false).
# Keep disabled in production; prefer structured `emit_artifact` tool output.
ALLOW_LEGACY_ARTIFACT_TAGS=false
# AI SDK V6 integration rollout flags (all default to enabled behavior).
AI_SDK_V6_CHAT_PERSISTENCE_ENABLED=true
AI_SDK_V6_MEMORY_ADAPTER_ENABLED=true
AI_SDK_V6_TYPED_ARTIFACTS_ENABLED=true
AI_SDK_V6_ROUTER_ENABLED=false
AI_SDK_V6_TOOL_CACHE_ENABLED=true
AI_SDK_V6_TOOL_CACHE_TTL_MS=120000
AI_SDK_V6_CACHE_CONTRACT_VERSION=2026-03-05

# Mem0 Memory Provider
MEM0_API_KEY=__MEM0_KEY__

# Langfuse Observability (optional but recommended)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Neon Auth (public keys can be committed; server key must stay secret)
NEXT_PUBLIC_STACK_PROJECT_ID=__STACK_PROJECT_ID__
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=__STACK_PUBLISHABLE_KEY__
STACK_SECRET_SERVER_KEY=__STACK_SERVER_KEY__

# Supabase database owner connection (used only in server-side API routes)
DATABASE_URL=postgresql://neondb_owner:__PASSWORD__@ep-young-meadow-a513cvgb-pooler.us-east-2.aws.neon.tech/nex-t1?sslmode=require&channel_binding=require

# Wallet / Web3 configuration
# Prefer keeping the Alchemy key server-side and proxying requests through Next.js.
NEXT_PUBLIC_ALCHEMY_PROXY_URL=/api/alchemy-rpc

# Solana autotrader (server-side, custodial signer)
# Base58-encoded 64-byte secret key (Keypair secretKey). Treat as a production secret.
# Leave unset unless you explicitly want the automation worker to execute buys.
SOLANA_AUTOTRADER_PRIVATE_KEY_B58=
# Optional: comma-separated Jito tip accounts used as a positive signal for bundled activity detection.
# Example: SOLANA_JITO_TIP_ACCOUNTS=SysvarRent111111111111111111111111111111111
SOLANA_JITO_TIP_ACCOUNTS=
# Leave empty to rely on the server-side proxy, or set only if you intentionally expose a publishable key.
NEXT_PUBLIC_ALCHEMY_API_KEY=
# Optional legacy alias if you already store the key under the old name.
NEXT_PUBLIC_ALCHEMY_KEY=__ALCHEMY_PUBLISHABLE_KEY__
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=__WALLETCONNECT_ID__
NEXT_PUBLIC_NZT_CHAIN_ID=1205614532052104
NEXT_PUBLIC_NZT_RPC_URL=https://rpc.devnet.alchemy.com/45cd077d-0137-4cba-8cab-3f7dc4d24e09
NEXT_PUBLIC_WALLET_ASSET_DETAIL_V1=false

# Safe smart wallets (ERC-4337)
# Notes:
# - WALLET_VAULT_KEY encrypts server-managed keys at rest (e.g., allowance delegates). Keep it stable and secret.
# - SAFE_DEPLOYER_PRIVATE_KEY pays gas for Safe deployments (backfill/provision).
# - SAFE_RELAYER_PRIVATE_KEY (optional) pays gas for relayed Safe tx execution; defaults to deployer key if unset.
WALLET_VAULT_KEY=
SAFE_DEPLOYER_PRIVATE_KEY=
SAFE_RELAYER_PRIVATE_KEY=
# ENS subname sponsorship and deployment
# - ENS_SUBNAME_REGISTRAR_ADDRESS is the deployed mainnet registrar contract used by the app.
# - ENS_SUBNAME_RELAYER_PRIVATE_KEY should be a dedicated gas sponsor key for ENS claim + reverse txs.
# - ENS_RELAYER_PRIVATE_KEY is a legacy alias; prefer ENS_SUBNAME_RELAYER_PRIVATE_KEY for production.
# - ENS_REGISTRAR_OWNER is the admin owner of the registrar.
# - ENS_PARENT_OWNER is the current nex-t1.eth registrant/controller used for wrap + operator approval.
# - ENS_NAME_WRAPPER and ENS_PUBLIC_RESOLVER default to the current official mainnet ENS deployments in the Foundry scripts.
ENS_SUBNAME_REGISTRAR_ADDRESS=
ENS_SUBNAME_RELAYER_PRIVATE_KEY=
ENS_RELAYER_PRIVATE_KEY=
ENS_MAINNET_RPC_URL=
REWARD_SIGNAL_SALT=
USDC_REWARD_TREASURY_PRIVATE_KEY=
BASE_RPC_URL=
ENS_REGISTRAR_OWNER=
ENS_REGISTRAR_RELAYER=
ENS_PARENT_OWNER=
ENS_NAME_WRAPPER=
ENS_PUBLIC_RESOLVER=
ENS_DEFAULT_TTL=0
# Optional Solana deployer keys for launchpad artifact deployment.
# If unset, server derives a Solana keypair from PRIVATE_KEY fallback.
SOLANA_PRIVATE_KEY_B58=
SOLANA_PRIVATE_KEY_JSON=
# Enable local owner key storage/signing (client-side). Default is false in production.
SAFE_LOCAL_OWNER_ENABLED=
# Client-side gate for local owner UX (default false in production).
NEXT_PUBLIC_SAFE_LOCAL_OWNER_ENABLED=false
# Passkey approvals require AAL2 by default; set to false to allow AAL1.
SAFE_PASSKEY_APPROVAL_REQUIRE_AAL2=true
# Optional: only required if you set SAFE_TX_SERVICE_URL_* to api.safe.global / api.5afe.dev endpoints.
SAFE_TX_SERVICE_API_KEY=
# Optional: restrict Safe provisioning to an explicit chain allowlist (comma-separated ids).
SAFE_TARGET_CHAIN_IDS=1,5,10,137,42161,42220,8453,130,43114

# Crossmint embedded smart wallets (Solana + Stellar)
# Notes:
# - Enable with NEXT_PUBLIC_ENABLE_CROSSMINT_WALLETS=true
# - CROSSMINT_API_KEY must have wallet scopes (e.g. wallets.create, wallets.read)
NEXT_PUBLIC_ENABLE_CROSSMINT_WALLETS=true
CROSSMINT_API_KEY=
# Crossmint environment: 'staging' (testnets) or 'production' (mainnets).
# Default behavior: staging in development, production in production.
CROSSMINT_ENV=staging
NEXT_PUBLIC_CROSSMINT_ENV=staging
# Optional: webhook signing secret (only needed if you enable Crossmint webhooks).
CROSSMINT_WEBHOOK_SECRET=

# Coinbase Developer Platform (CDP) Embedded Wallets
# Generate RSA keys:  openssl genrsa -out cdp-private.pem 2048 && openssl rsa -in cdp-private.pem -pubout -out cdp-public.pem
# Then paste PEM contents (replace newlines with \n) into env vars below.
NEXT_PUBLIC_CDP_PROJECT_ID=               # From CDP Portal
NEXT_PUBLIC_ENABLE_CDP_WALLETS=false      # Feature flag — set true to enable
NEXT_PUBLIC_CDP_ENABLE_IN_DEV=false       # Optional dev-only opt-in; set true after localhost origin is allowlisted in CDP
# Server SDK credentials (wallet pre-generation)
CDP_API_KEY_ID=                           # From CDP Portal > API Keys
CDP_API_KEY_SECRET=                       # From CDP Portal > API Keys
CDP_WALLET_SECRET=                        # From CDP Portal > Server Wallet
# JWT Bridge (HS256 → RS256 re-signing for CDP Custom Auth)
CDP_JWT_RSA_PRIVATE_KEY=                  # PEM PKCS8 private key (single-line, \n-escaped)
CDP_JWT_RSA_PUBLIC_KEY=                   # PEM SPKI public key (single-line, \n-escaped)
CDP_JWT_ISSUER=https://nex-t1.ai          # JWT issuer claim
CDP_JWT_AUDIENCE=cdp                      # JWT audience claim
CDP_JWT_TTL_SECONDS=300                   # Token lifetime (default 5 min)
# Optional: key rotation (serve both public keys in JWKS during rotation window)
# CDP_JWT_RSA_PRIVATE_KEY_2=
# CDP_JWT_RSA_PUBLIC_KEY_2=
# CDP_JWT_ACTIVE_KID=cdp-key-1
# Optional: feature flags for legacy providers (default true for backward compat)
# ENABLE_SAFE_WALLETS=true
# ENABLE_CROSSMINT_STELLAR=true

# Provisioning retry tuning (optional)
SAFE_PROVISION_MAX_ATTEMPTS=5
SAFE_PROVISION_BACKOFF_BASE_SECONDS=30
SAFE_PROVISION_BACKOFF_MAX_SECONDS=3600

# RPC URLs (Safe provisioning + execution)
SAFE_RPC_URL_BASE=https://mainnet.base.org
SAFE_RPC_URL_OPTIMISM=https://mainnet.optimism.io
SAFE_RPC_URL_BNB=https://bsc-dataseed.binance.org
SAFE_RPC_URL_ETHEREUM=https://ethereum.publicnode.com
SAFE_RPC_URL_ARBITRUM=https://arb1.arbitrum.io/rpc
SAFE_RPC_URL_POLYGON=https://polygon-rpc.com
SAFE_RPC_URL_CELO=https://forno.celo.org
SAFE_RPC_URL_UNICHAIN=https://unichain-rpc.publicnode.com
SAFE_RPC_URL_AVALANCHE=https://api.avax.network/ext/bc/C/rpc

# Optional: Safe Transaction Service overrides (leave empty to use SDK defaults where available)
SAFE_TX_SERVICE_URL_8453=
SAFE_TX_SERVICE_URL_56=
SAFE_TX_SERVICE_URL_10=
SAFE_TX_SERVICE_URL_1=
SAFE_TX_SERVICE_URL_42161=
SAFE_TX_SERVICE_URL_137=
SAFE_TX_SERVICE_URL_42220=
SAFE_TX_SERVICE_URL_130=
SAFE_TX_SERVICE_URL_43114=

# Optional: Custom networks (require Safe deployment overrides: SAFE_*_<chainId>)
# Hyperliquid EVM (legacy alias: SAFE_HYPEREVM_CHAIN_ID / SAFE_RPC_URL_HYPEREVM)
SAFE_HYPERLIQUID_EVM_CHAIN_ID=999
SAFE_RPC_URL_HYPERLIQUID_EVM=https://rpc.hyperliquid.xyz/evm
SAFE_TX_SERVICE_URL_HYPERLIQUID_EVM=
# Monad
SAFE_MONAD_CHAIN_ID=
SAFE_RPC_URL_MONAD=
SAFE_TX_SERVICE_URL_MONAD=

# For custom networks you must set deployment overrides:
# SAFE_SINGLETON_<chainId>=0x...
# SAFE_PROXY_FACTORY_<chainId>=0x...
# SAFE_MODULE_SETUP_<chainId>=0x...
# SAFE_SAFE_4337_MODULE_<chainId>=0x...
# SAFE_ALLOWANCE_MODULE_<chainId>=0x...

# Polymarket Integration (prediction markets)
# Builder credentials from https://polymarket.com/settings?tab=builder
