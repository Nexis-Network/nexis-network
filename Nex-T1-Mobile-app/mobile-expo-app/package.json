    "@vitest/coverage-v8": "^3.2.4",
    "detox": "^20.0.0",
    "eslint": "^9.37.0",
    "eslint-config-expo": "~8.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.0",
    "vitest": "^3.2.4"
  }
