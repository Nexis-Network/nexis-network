{
  "name": "nex-t1-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:production": "eas build --profile production",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "detox test --configuration ios.sim.debug",
    "test:e2e:build": "detox build --configuration ios.sim.debug",
    "prebuild": "expo prebuild",
    "clean": "expo prebuild --clean",
    "validate": "npm run type-check && npm run lint && npm run test"
  },
  "dependencies": {
    "@crossmint/client-sdk-react-native-ui": "^0.13.19",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.5.2",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.76.1",
    "@tanstack/react-query": "^5.90.2",
    "@walletconnect/ethereum-provider": "^2.23.1",
    "@walletconnect/modal-react-native": "^1.1.0",
    "@walletconnect/react-native-compat": "^2.23.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "expo": "~52.0.0",
    "expo-apple-authentication": "~7.1.3",
    "expo-application": "~6.0.0",
    "expo-auth-session": "~6.0.3",
    "expo-blur": "~14.0.3",
    "expo-camera": "~16.0.0",
    "expo-clipboard": "~7.0.0",
    "expo-constants": "~17.0.0",
    "expo-crypto": "~14.0.0",
    "expo-device": "~7.0.0",
    "expo-font": "~13.0.0",
    "expo-haptics": "~14.0.0",
    "expo-image": "~2.0.0",
    "expo-linking": "~7.0.0",
    "expo-local-authentication": "~15.0.0",
    "expo-notifications": "~0.29.0",
